{
  "name": "theme",
  "version": "4.4.0",
  "description": "",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run build:clean && npm run build:tailwind",
    "build:clean": "rimraf ../../static/css/tailwind.css",
    "build:tailwind": "npx @tailwindcss/cli -i ./src/styles.css -o ../../static/css/tailwind.css --minify",
    "dev": "npx @tailwindcss/cli -i ./src/styles.css -o ../../static/css/tailwind.css --watch"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "tailwindcss": "^4.0.0",
    "daisyui": "^5.0.0",
    "rimraf": "^6.0.1",
    "cross-env": "^7.0.3"
  }
}