# =====================================================
# Variables de Entorno - Template para nuevo deployment
# =====================================================
# Copia este archivo: cp .env.example .env
# Luego edita .env con tus valores reales
# Los valores con comentario "cambia esto" son obligatorios

# =====================================================
# Dominio y Puertos
# =====================================================
DOMAIN=tu-dominio.com          # Dominio público del servidor (sin https://)
N8N_PORT=5679                  # Puerto local de n8n → nginx redirige / a este puerto
GRADIO_PORT=7860               # Puerto local de Gradio → nginx redirige /gradio/ aquí
API_PORT=8009                  # Puerto local de FastAPI → nginx redirige /api/ aquí
DJANGO_PORT=8010               # Puerto local de Django → nginx redirige /dashboard/ aquí
MCP_PORT=3001                  # Puerto local del servidor MCP → nginx redirige /mcp aquí

# =====================================================
# PostgreSQL
# =====================================================
POSTGRES_USER=tu_usuario                        # Usuario de PostgreSQL (cambia esto)
POSTGRES_PASSWORD=cambia_esta_password_segura   # Password de PostgreSQL (cambia esto)
POSTGRES_DB=pozos                               # DB usada por n8n (no cambiar)

# =====================================================
# N8N
# =====================================================
# Genera claves nuevas con: openssl rand -base64 32
N8N_ENCRYPTION_KEY=genera-una-clave-con-openssl-rand-base64-32     # Cifra credenciales en n8n (cambia esto)
N8N_USER_MANAGEMENT_JWT_SECRET=genera-otra-clave-con-openssl-rand-base64-32  # JWT para autenticación (cambia esto)

N8N_SECURE_COOKIE=true  # true en producción con HTTPS, false en desarrollo local

# API Key de n8n — se genera DESPUÉS de levantar n8n por primera vez:
# Settings → API → Create API Key
# Luego recrear los contenedores: docker compose up -d --force-recreate n8n-mcp django
N8N_API_KEY=genera-desde-panel-n8n

# =====================================================
# ChromaDB
# =====================================================
CHROMA_HOST=chroma             # Hostname del contenedor ChromaDB en la red Docker
CHROMA_PORT=8000               # Puerto interno de ChromaDB
CHROMA_COLLECTION=pozos        # Nombre de la colección vectorial principal

# =====================================================
# Gradio
# =====================================================
GRADIO_AUTH_USERNAME=admin                 # Usuario de acceso al panel Gradio
GRADIO_AUTH_PASSWORD=cambia_esta_password  # Password del panel Gradio (cambia esto)
GRADIO_ROOT_PATH=/gradio                   # Sub-path de Gradio (no cambiar)
ENV=production
DEBUG=false

# =====================================================
# OpenAI (para embeddings)
# =====================================================
OPENAI_API_KEY=sk-proj-tu-clave-de-openai  # Clave de OpenAI para generar embeddings (cambia esto)
EMBEDDING_MODEL=text-embedding-3-large      # Modelo de embeddings (text-embedding-3-large o text-embedding-ada-002)

# =====================================================
# API Microservicio (FastAPI — búsqueda MMR)
# =====================================================
API_HOST=0.0.0.0       # Interface de escucha de la API
API_ROOT_PATH=/api     # Sub-path de la API (no cambiar, afecta Swagger /api/docs)

# =====================================================
# MCP — Control de n8n desde AI IDEs (Cursor, Claude Code)
# =====================================================
# String libre que actúa como Bearer token para el servidor MCP
# Usar el mismo valor en: Authorization: Bearer <token> en la config del IDE
MCP_AUTH_TOKEN=genera-un-token-seguro-para-mcp

# =====================================================
# Django Dashboard
# =====================================================
# Genera SECRET_KEY con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=genera-una-clave-secreta-larga   # Clave secreta de Django (cambia esto)
DJANGO_DB=n8n_django                               # Nombre de la DB de Django en PostgreSQL (no cambiar)

# CSRF — dominio(s) confiados para formularios Django (separados por coma)
# Debe incluir el dominio con https:// exactamente como llega en el header
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com

# =====================================================
# Django — Integración con n8n
# =====================================================
# URL base de n8n que usa Django para llamar a la API REST
# En producción se configura automáticamente desde docker-compose como https://${DOMAIN}
# En desarrollo local se sobreescribe en docker-compose.override.yml como http://n8n:5678
# Solo necesitás definir esta variable si corrés Django fuera de Docker
# N8N_URL=http://localhost:5679

# =====================================================
# Django — Webhooks opcionales de n8n
# =====================================================
# Los siguientes webhooks son OPCIONALES — se usan como fallback cuando la
# API REST de n8n no tiene acceso directo (ej. plan free trial, permisos)

# Webhook para actualizar prompt_ajuste en la DataTable de auditoría
# Si está vacío, Django usa la API REST: PATCH /api/v1/data-tables/{id}/rows/update
N8N_WEBHOOK_UPDATE_AUDIT_PROMPT=

# ID del workflow de n8n que contiene el nodo de system prompt a actualizar
# Se ve en la URL al abrir el workflow: /workflow/ESTE_ID
N8N_WORKFLOW_PROMPT_ID=wY2zlf23Ju6Yiiib

# Nombre del nodo dentro del workflow que contiene el system prompt (opcional)
# Si está vacío, se busca por nodo_ajuste_id en el registro de auditoría
N8N_NODE_NAME_PROMPT=

# Webhook para actualizar el nodo de prompt directamente en el workflow
# Si está vacío, Django usa la API REST: GET workflow → modifica nodo → PUT workflow
N8N_WEBHOOK_UPDATE_PROMPT_NODE=
